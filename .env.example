# ══ NOVA-ALPHA AUTO — Environment Variables ══
# Salin nilai ini ke Render Dashboard > Environment

# ── MOD (paling penting) ──────────────────────────────
DRY_RUN=true              # true = paper trading (TIADA duit sebenar). false = LIVE
KILL_SWITCH=false         # true = henti semua entry baru serta-merta (kecemasan)

# ── EXCHANGE ──────────────────────────────────────────
EXCHANGE=gateio           # gateio | binance
API_KEY=                  # dari exchange — beri permission SPOT TRADE sahaja
API_SECRET=               # JANGAN beri permission withdraw!

# ── RISK CONTROLS ─────────────────────────────────────
PAPER_CAPITAL_USDT=200    # modal simulasi semasa DRY_RUN
RISK_PCT=1.0              # % equity dirisiko setiap trade (1% = konservatif, bagus)
MAX_POSITION_USDT=25      # saiz maksimum 1 trade (USDT)
MIN_ORDER_USDT=6          # bawah ini order di-skip (min exchange ~$5)
MAX_OPEN_TRADES=3         # maksimum posisi terbuka serentak
MAX_DAILY_LOSS_PCT=5      # rugi harian capai ini → henti entry sampai esok (UTC)
MAX_CONSEC_SL=3           # SL berturut capai ini → rehat
HALT_HOURS=6              # tempoh rehat selepas SL berturut
SLIPPAGE_MAX_PCT=1.5      # harga lari lebih ini semasa order → batal (LIVE)
TP1_SELL_PCT=40           # % dijual di TP1 (SL → breakeven)
TP2_SELL_PCT=40           # % dijual di TP2 (SL → TP1) — baki dijual di TP3

# ── QUALITY GATES (dari alpha) ────────────────────────
MIN_EV=0.10               # expectancy minimum selepas fee (R). Naikkan = lebih ketat
BLOCK_DEAD_ZONE=true      # blok entry 22:00–01:59 UTC (likuiditi nipis)
WHALE_VETO=true           # blok entry jika whale proxy kesan distribution
FEE_PER_SIDE=0.002        # 0.2% spot taker (gate/binance lebih kurang sama)

# ── TELEGRAM (OPTIONAL — notifikasi sahaja, bukan wajib) ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ADMIN_CHAT_ID=

# ── SUPABASE (OPTIONAL tapi disyorkan — Render free padam disk setiap deploy) ──
SUPABASE_URL=
SUPABASE_KEY=
